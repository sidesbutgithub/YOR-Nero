                                <joint name="right_arm_joint7" axis="0 0 1" range="-1.57 1.57"/>
                                <geom mesh="link7" class="visual" material="gray_mat"/>
                                <geom mesh="link7" class="collision"/>
                                
                                <!-- End Effector with stand_v2 -->
                                <body name="right_arm_end_effector" pos="0 0.033 -0.0235" gravcomp="1">
                                  <inertial pos="-0.01208 -0.00025 0.00032" mass="0.05" diaginertia="2.697e-05 4.311e-05 2.479e-05" />
                                  <geom mesh="stand_v2" euler="-1.57 0 -1.57" class="visual" material="gray_mat"/>
                                  <geom mesh="stand_v2" euler="-1.57 0 -1.57" class="collision"/>
                                  <site name="right_arm_ee" pos="0 0 0.1"/>
                                </body>
                              </body>
                            </body>
                          </body>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
          </body>
        </body>
      </body>
      <site name="base_site" pos="0 0 0" quat="1 0 0 0" />
      <camera name="front_camera" mode="track" fovy="90.0"
        quat="4.329780281177467e-17 4.329780281177466e-17 0.7071067811865475 0.7071067811865476"
        pos="0.0 2.0 0.5" />
      <camera name="side_camera" mode="track" fovy="90.0"
        quat="-0.5 -0.4999999999999999 0.5 0.5000000000000001" pos="-2.0 0.0 0.5" />
    </body>
  </worldbody>

  <actuator>
    <position name="front_left_steer_ctrl" joint="front_left_steer" class="steering_joint" />
    <velocity name="drive_front_left_ctrl" joint="drive_front_left" class="drive_joint" />
    <position name="back_left_steer_ctrl" joint="back_left_steer" class="steering_joint" />
    <velocity name="drive_back_left_ctrl" joint="drive_back_left" class="drive_joint" />
    <position name="front_right_steer_ctrl" joint="front_right_steer" class="steering_joint" />
    <velocity name="drive_front_right_ctrl" joint="drive_front_right" class="drive_joint" />
    <position name="back_right_steer_ctrl" joint="back_right_steer" class="steering_joint" />
    <velocity name="drive_back_right_ctrl" joint="drive_back_right" class="drive_joint" />

    <position name="lift" tendon="lift" class="telescope" />

    
    <!-- Left arm actuators (7 DOF) -->
    <position name="left_arm_joint1_pos" joint="left_arm_joint1" class="nero" kp="15" kv="1.5"/>
    <position name="left_arm_joint2_pos" joint="left_arm_joint2" class="nero" kp="15" kv="1.5"/>
    <position name="left_arm_joint3_pos" joint="left_arm_joint3" class="nero" kp="15" kv="1.5"/>
    <position name="left_arm_joint4_pos" joint="left_arm_joint4" class="nero" kp="15" kv="1.5"/>
    <position name="left_arm_joint5_pos" joint="left_arm_joint5" class="nero" kp="15" kv="1.5"/>
    <position name="left_arm_joint6_pos" joint="left_arm_joint6" class="nero" kp="15" kv="1.5"/>
    <position name="left_arm_joint7_pos" joint="left_arm_joint7" class="nero" kp="15" kv="1.5"/>

    <!-- Right arm actuators (7 DOF) -->
    <position name="right_arm_joint1_pos" joint="right_arm_joint1" class="nero" kp="15" kv="1.5"/>
    <position name="right_arm_joint2_pos" joint="right_arm_joint2" class="nero" kp="15" kv="1.5"/>
    <position name="right_arm_joint3_pos" joint="right_arm_joint3" class="nero" kp="15" kv="1.5"/>
    <position name="right_arm_joint4_pos" joint="right_arm_joint4" class="nero" kp="15" kv="1.5"/>
    <position name="right_arm_joint5_pos" joint="right_arm_joint5" class="nero" kp="15" kv="1.5"/>
    <position name="right_arm_joint6_pos" joint="right_arm_joint6" class="nero" kp="15" kv="1.5"/>
    <position name="right_arm_joint7_pos" joint="right_arm_joint7" class="nero" kp="15" kv="1.5"/>
    
  </actuator>

  <contact>
    <exclude body1="left_arm_base_link" body2="left_arm_link1" />
    <exclude body1="right_arm_base_link" body2="right_arm_link1" />
    <exclude body1="Lift_Top" body2="left_arm_base_link" />
    <exclude body1="Lift_Top" body2="right_arm_base_link" />
    <exclude body1="base_profile_short" body2="Part_2" />
    <exclude body1="base_profile_short" body2="Part_2_2" />
    <exclude body1="Part_2" body2="MK4_Colson_Hub_4_X_1.5" />
    <exclude body1="base_profile_short" body2="Part_2_3" />
    <exclude body1="Part_2_2" body2="MK4_Colson_Hub_4_X_1.5_2" />
    <exclude body1="base_profile_short" body2="Part_2_4" />
    <exclude body1="base_profile_short" body2="Lift_Middle" />
    <exclude body1="Part_2_3" body2="MK4_Colson_Hub_4_X_1.5_3" />
    <exclude body1="Part_2_4" body2="MK4_Colson_Hub_4_X_1.5_4" />
    <exclude body1="Lift_Middle" body2="Lift_Top" />
  </contact>

  <tendon>
    <fixed name="lift">
      <joint joint="Slider_1" coef="1"/>
      <joint joint="Slider_2" coef="1"/>
    </fixed>
  </tendon>

  <sensor>
    <framepos name="base_site_pos" objtype="site" objname="base_site" />
    <framequat name="base_site_quat" objtype="site" objname="base_site" />
    <framelinvel name="base_site_linvel" objtype="site" objname="base_site" />
    <frameangvel name="base_site_angvel" objtype="site" objname="base_site" />
    <velocimeter name="base_site_vel" site="base_site" />
  </sensor>
</mujoco>